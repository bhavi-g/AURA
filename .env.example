# AURA environment example — copy to .env and fill in.
# .env is gitignored; never commit real keys.

# --- LLM (optional) ---
# Used by `aura explain --llm`, `aura explain-llm`, and `aura fix`.
# If unset, AURA falls back to a deterministic stub (no API calls, no cost).
#
# Provider selection: AURA_LLM_PROVIDER=anthropic|openai (optional). If unset,
# AURA auto-detects: Anthropic first (if ANTHROPIC_API_KEY is set), then
# OpenAI (if OPENAI_API_KEY is set), then the stub.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AURA_LLM_PROVIDER=anthropic

# --- Persistence (optional) ---
# Base directory for the SQLite database (aura.db). Defaults to ./.aura
# AURA_DB_DIR=.aura

# --- Frontend (build-time, optional) ---
# Base URL the React app calls. Defaults to /api when unset.
# Set to your deployed backend, e.g. https://aura-backend.example.com
# VITE_API_BASE_URL=/api
